{
  "cleanUrls": true,
  "redirects": [
    { "source": "/tools", "destination": "/hub", "permanent": false },
    { "source": "/tools/", "destination": "/hub", "permanent": false },
    { "source": "/tools/hub", "destination": "/hub", "permanent": false },
    { "source": "/tools/hub.html", "destination": "/hub", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}